# The DeAngelo Series — environment variables
# Copy this file to .env.local and fill in real values for local dev.
# .env.local is gitignored — never commit real values.
# In production: set these in Cloudflare Pages Dashboard > Settings > Environment Variables.

# ── Stripe (test mode) ───────────────────────────────────────────────────────
# Dashboard: https://dashboard.stripe.com/test/apikeys
# create-checkout-session.js refuses to run unless this starts with sk_test_.
STRIPE_SECRET_KEY=sk_test_...
# From Stripe Dashboard > Developers > Webhooks > your endpoint > Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# Publishable key (browser-safe — no secret access).
# Not currently read by any code: checkout redirects to a server-created
# Stripe Checkout Session URL, so Stripe.js/Elements aren't loaded in the
# browser. Kept here for when a future embedded payment form needs it.
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Set to "true" only after Stripe Tax is registered/configured in the
# Dashboard (Settings > Tax). Defaults to disabled — create-checkout-session.js
# will not silently claim tax is being collected.
STRIPE_TAX_ENABLED=false

# ── Site ─────────────────────────────────────────────────────────────────────
# Used to build the Checkout success/cancel redirect URLs.
SITE_URL=https://thedeangeloseries.com

# ── Printify (wire after confirming product/variant IDs) ─────────────────────
# Dashboard: https://printify.com/app/settings/api
# Used by functions/_lib/printify.js — never sent to the browser, never logged.
# NOT currently set in the Cloudflare Pages project (confirmed via
# `wrangler pages secret list` on 2026-07-25) — every Printify API call fails
# cleanly with "not configured" until this is added.
PRINTIFY_API_TOKEN=
# IS currently set in the Cloudflare Pages project.
PRINTIFY_SHOP_ID=
# Set to "true" to auto-submit orders to Printify production fulfillment.
# Keep "false" (or unset) while in Stripe test mode. Only gates the unused-by-
# default sendPrintifyOrderToProduction() in functions/_lib/printify.js —
# nothing in this codebase calls it automatically regardless of this value.
PRINTIFY_AUTO_SEND_TO_PRODUCTION=false
# Printify shipping profile/method ID for standard shipping. NOTE: the exact
# name is PRINTIFY_SHIPPING_METHOD_ID (not PRINTIFY_SHIPPING_METHOD) — that's
# what functions/_lib/printify.js reads.
PRINTIFY_SHIPPING_METHOD_ID=
# HMAC-SHA256 signing secret for /api/printify-webhook, from Printify
# Dashboard > Webhooks > (endpoint) > Secret. REQUIRED for webhook signature
# verification — printify-webhook.js FAILS CLOSED if this is not set: every
# request is rejected with 503 before the body is even parsed. There is no
# "accept unsigned requests" fallback in this codebase.
PRINTIFY_WEBHOOK_SECRET=

# ── Resend (transactional email) ──────────────────────────────────────────────
# Dashboard: https://resend.com/api-keys
# Used by functions/_lib/resend.js — never sent to the browser, never logged.
RESEND_API_KEY=
# Sender address for every email this site sends (contact acknowledgment,
# contact-form notification to support, and future order-status emails).
FROM_EMAIL=orders@thedeangeloseries.com
# Where the contact form's messages are delivered, and the default Reply-To
# for outgoing email when REPLY_TO_EMAIL is unset.
SUPPORT_EMAIL=support@thedeangeloseries.com
# Optional — overrides SUPPORT_EMAIL as the Reply-To address if set.
REPLY_TO_EMAIL=
