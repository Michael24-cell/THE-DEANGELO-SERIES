# The DeAngelo Series — environment variables
# Copy this file to .env.local and fill in real values for local dev.
# .env.local is gitignored — never commit real values.
# In production: set these in Cloudflare Pages Dashboard > Settings > Environment Variables.

# ── Stripe (test mode) ───────────────────────────────────────────────────────
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Publishable key (browser-safe — no secret access)
# Dashboard: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Site ─────────────────────────────────────────────────────────────────────
SITE_URL=https://thedeangeloseries.com

# ── Printify (wire after confirming product/variant IDs) ─────────────────────
# Dashboard: https://printify.com/app/settings/api
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
# Set to "true" to auto-submit orders to Printify production fulfillment.
# Keep "false" (or unset) while in Stripe test mode.
PRINTIFY_AUTO_SEND_TO_PRODUCTION=false
# Printify shipping profile/method ID for standard shipping
PRINTIFY_SHIPPING_METHOD_ID=

# ── Resend (order confirmation emails) ───────────────────────────────────────
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=
FROM_EMAIL=orders@thedeangeloseries.com
SUPPORT_EMAIL=support@thedeangeloseries.com
